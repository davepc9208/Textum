    {
      "@type": "FAQPage",
      "@id": "https://www.mentoriatextum.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿TEXTUM escribe tesis completas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. TEXTUM acompaña metodológicamente al investigador para que sea el propio autor quien construya y firme su investigación. La autoría intelectual pertenece siempre al investigador."
          }
        },
        {
          "@type": "Question",
          "name": "¿TEXTUM ayuda a publicar en Scopus?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. El programa Pre-arbitraje Científico + FLUX® está diseñado específicamente para optimizar manuscritos antes del envío a revistas Scopus, maximizando la probabilidad de aceptación."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta la mentoría de TEXTUM?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los precios de referencia van desde 110 EUR (defensa oral) hasta 750 EUR (publicación premium). El diagnóstico inicial es gratuito. Todos los pagos son únicos, sin cuotas ni renovaciones."
          }
        },
        {
          "@type": "Question",
          "name": "¿TEXTUM trabaja con doctorandos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Los doctorandos son uno de los perfiles principales de TEXTUM, junto con maestrandos, tesistas de grado e investigadores que desean publicar en revistas indexadas."
          }
        },
        {
          "@type": "Question",
          "name": "¿TEXTUM trabaja en inglés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Los servicios están disponibles en español e inglés para investigadores que trabajan o publican en ese idioma."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo empieza el proceso con TEXTUM?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Con un diagnóstico académico gratuito donde se evalúa el estado del proyecto y se orienta al investigador hacia el programa más adecuado. Se puede solicitar en mentoriatextum.com o por WhatsApp."
          }
        }
      ]
    },
